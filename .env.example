# =============================================================================
# Help Desk SEP — variables de entorno
# Copia este archivo a ".env" y ajusta los valores. Nunca subas ".env" al repo.
# =============================================================================

# ----- General -----
NODE_ENV=development

# Puerto público que expone Caddy hacia internet (HTTPS).
# Para cambiarlo: edita este valor y corre `docker compose up -d` de nuevo.
APP_PORT=4324
# IP o dominio público usado por Caddy para seleccionar el certificado.
PUBLIC_HOST=localhost

# ----- Base de datos (PostgreSQL autoalojada en Docker) -----
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=helpdesk

# Usada por Prisma CLI y por `npm run dev` fuera de Docker (host = localhost,
# ya que docker-compose publica el puerto 5432 solo en localhost para desarrollo).
# Dentro de Docker, docker-compose.yml sobreescribe esta variable para el
# contenedor "app" usando el host interno "db".
DATABASE_URL="postgresql://helpdesk:cambia_esta_contrasena@localhost:5432/helpdesk?schema=public"

# ----- Autenticación (Auth.js) -----
# Genera uno nuevo con: openssl rand -base64 32
AUTH_SECRET="cambia_este_valor_con_openssl_rand_base64_32"
# URL pública completa por la que se accede al sistema (usa el mismo puerto que APP_PORT).
AUTH_URL="https://localhost:4324"

# ----- Usuario administrador inicial (solo lo usa el script de seed) -----
ADMIN_NAME="Nombre Apellido"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambia_esta_contrasena_fuerte"

# ----- Adjuntos -----
# Ruta donde se guardan los archivos subidos (capturas, PDFs).
# Igual que con DATABASE_URL, docker-compose.yml sobreescribe esto a "/data/uploads"
# (una ruta absoluta dentro del volumen del contenedor) para el servicio "app".
UPLOADS_DIR="./data/uploads"
MAX_ATTACHMENT_SIZE_MB=10

# ----- Correo (fase 2 — se configura también desde Ajustes en el dashboard) -----
# Clave usada para cifrar las contraseñas de los buzones guardadas en la base de datos.
# Genera una con: openssl rand -base64 32
MAILBOX_ENCRYPTION_KEY="cambia_este_valor_con_openssl_rand_base64_32"
