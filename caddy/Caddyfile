# Caddyfile — proxy inverso con HTTPS para el Help Desk.
#
# Sin dominio propio todavía: usamos "tls internal" (certificado autofirmado).
# El navegador mostrará una advertencia de seguridad hasta que se configure un
# dominio real. Para producción con dominio, elimina `tls internal` para que
# Caddy emita un certificado válido de Let's Encrypt automáticamente.

{
	admin off
	auto_https disable_redirects
	default_sni {$PUBLIC_HOST}

	servers :443 {
		protocols h1 h2
	}
}

localhost:443, {$PUBLIC_HOST}:443 {
	tls internal

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}
